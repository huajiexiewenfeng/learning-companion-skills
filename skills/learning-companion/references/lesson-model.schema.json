{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-companion.local/schemas/lesson-model.v1.json",
  "title": "Learning Companion Lesson Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "session", "theme", "question", "requiredTerms", "sections"],
  "properties": {
    "schemaVersion": {"const": "learning-companion.lesson-model.v1"},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "planId", "day", "topic", "mode", "depth", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "planId": {"type": "string", "minLength": 1},
        "day": {"type": "integer", "minimum": 1},
        "topic": {"type": "string", "minLength": 1},
        "mode": {"enum": ["text", "voice", "hybrid"]},
        "depth": {"enum": ["shallow", "medium", "deep"]},
        "status": {"enum": ["preparing", "ready", "in-progress", "completed", "archived"]}
      }
    },
    "theme": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "requiredTerms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decks": {
      "type": "array",
      "items": {"$ref": "#/$defs/deck"}
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sectionIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "sectionIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "summary", "sourceRefs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["hero", "concept", "layer-map", "boundary-map", "flow", "timeline", "case-study", "misconception", "check-question", "sources"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "boundary-map"}}},
          "then": {
            "required": ["nodes"],
            "properties": {
              "nodes": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/node"},
                    {
                      "required": ["group"],
                      "properties": {"group": {"type": "string", "minLength": 1}}
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "kind": {"type": "string", "minLength": 1},
        "group": {"type": "string"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "label": {"type": "string"}
      }
    }
  }
}
